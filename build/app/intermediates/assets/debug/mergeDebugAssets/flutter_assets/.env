# Environment Configuration Template
# Copy this file to .env and update with your actual configuration

# Backend API Configuration
# Local dev (Chrome -> localhost)
BACKEND_BASE_URL=http://localhost:3000
# Map module expects BACKEND_URL
BACKEND_URL=http://localhost:3001

# SearXNG Configuration
# Keep Golligog on a dedicated port to avoid clash with Krysonix backend (:5000).
# Use localhost here; Android emulators are normalized to 10.0.2.2 in code.
SEARXNG_BASE_URL=http://localhost:5001

# Map tiles (OpenStreetMap vector mbtiles rendered via TileServer + OpenResty)
MAPTILESERVER_URL=http://localhost:8081/styles/basic-preview/{z}/{x}/{y}.png?key=myfirstkey

# Nominatim (search) fallback
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Local OSRM (routing)
OSRM_URL=http://127.0.0.1:5000

# Geofabrik source for Nominatim + OSRM data
SOUTHERN_ZONE_GEOFABRIK_URL=https://download.geofabrik.de/asia/india/southern-zone-latest.osm.pbf

# Bock Foods API Configuration
# Set to BockFoodsServer URL (default: http://localhost:3000)
# Make sure BockFoodsServer is running on this port
BOCK_FOODS_API_BASE_URL=http://localhost:3000

# Orventus API Configuration
# Dedicated port to avoid collision with other Bock services
ORVENTUS_API_BASE_URL=http://localhost:3010
# Optional fallback for modules reading generic API_BASE_URL
API_BASE_URL=http://localhost:3010
